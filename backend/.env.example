# Provider mode: "mock" or "akahu"
PROVIDER_MODE=mock

# Claude AI
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Database — PostgreSQL (preferred)
# Start with Docker: docker run -d --name openbanking-postgres \
#   -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=postgres \
#   -e POSTGRES_DB=openbanking -p 5432:5432 postgres:15
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbanking

# Database — SQLite (zero-setup fallback, no Docker required)
# DATABASE_URL=sqlite:///./openbanking.db

# Akahu credentials (only needed when PROVIDER_MODE=akahu)
AKAHU_BASE_URL=https://api.akahu.io/v1
AKAHU_APP_TOKEN=your_app_token_here
AKAHU_USER_TOKEN=your_user_token_here

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# MCP analytics server URL (consumed by backend when calling MCP tools)
MCP_SERVER_URL=http://localhost:8001
