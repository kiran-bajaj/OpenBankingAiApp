# Provider mode: "mock" or "akahu"
PROVIDER_MODE=mock

# Claude AI
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# Database
# SQLite — zero setup, default for local development:
DATABASE_URL=sqlite:///./openbanking.db
# PostgreSQL — swap to this when Postgres is available:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openbanking

# Akahu credentials (only needed when PROVIDER_MODE=akahu)
AKAHU_BASE_URL=https://api.akahu.io/v1
AKAHU_APP_TOKEN=your_app_token_here
AKAHU_USER_TOKEN=your_user_token_here

# CORS
FRONTEND_ORIGIN=http://localhost:5173
